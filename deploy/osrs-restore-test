#!/usr/bin/env bash
#
# Restore the newest backup into a scratch database and check it is real.
#
# This is the half that gets skipped, and it is the half that matters. A
# repository that accepts writes but cannot be read back looks exactly
# like a working backup right up to the morning you need it. Every
# number osrs-backup prints is about the upload; none of them is evidence
# that a restore produces a database.
#
# Safe to run whenever: it restores into a throwaway database with its own
# name and drops it afterwards. It never touches the live one.
#
set -euo pipefail

cd /srv/osrs
set -a
# shellcheck disable=SC1091
source .env
set +a

SCRATCH="${POSTGRES_DB}_restoretest"
workdir=$(mktemp -d /tmp/osrs-restore-XXXXXX)
trap 'rm -rf "$workdir"; docker compose exec -T db psql -U "$POSTGRES_USER" -d postgres -q -c "DROP DATABASE IF EXISTS $SCRATCH" >/dev/null 2>&1 || true' EXIT

for required in RESTIC_REPOSITORY RESTIC_PASSWORD POSTGRES_USER POSTGRES_DB; do
  [ -n "${!required:-}" ] || { echo "!! $required is not set" >&2; exit 1; }
done

echo "==> newest snapshot"
restic snapshots --tag osrs --latest 1 || { echo "!! no snapshots found" >&2; exit 1; }

echo "==> restoring to $workdir"
restic restore latest --tag osrs --target "$workdir" || { echo "!! restore failed" >&2; exit 1; }

dump=$(find "$workdir" -name '*.sql.gz' | head -1)
[ -n "$dump" ] || { echo "!! the snapshot contained no .sql.gz" >&2; exit 1; }
echo "==> restored $(numfmt --to=iec "$(stat -c %s "$dump")")"

echo "==> loading into $SCRATCH"
docker compose exec -T db psql -U "$POSTGRES_USER" -d postgres -q -c "DROP DATABASE IF EXISTS $SCRATCH"
docker compose exec -T db psql -U "$POSTGRES_USER" -d postgres -q -c "CREATE DATABASE $SCRATCH"
gunzip -c "$dump" | docker compose exec -T db psql -U "$POSTGRES_USER" -d "$SCRATCH" -q >/dev/null 2>&1 \
  || { echo "!! the dump would not load" >&2; exit 1; }

echo
echo "==> comparing the restore against live"
printf '%-22s %12s %12s\n' TABLE LIVE RESTORED

problems=0
# The tables whose loss would actually hurt: things people typed in, not
# things a job can refetch. Prices and history rebuild themselves within
# the hour; a trade journal does not.
for table in users osrs_accounts osrs_trades osrs_quest_progress osrs_alerts osrs_watchlist osrs_goals osrs_news osrs_items; do
  live=$(docker compose exec -T db psql -U "$POSTGRES_USER" -d "$POSTGRES_DB" -tAc \
    "SELECT count(*) FROM $table" 2>/dev/null || echo 'n/a')
  restored=$(docker compose exec -T db psql -U "$POSTGRES_USER" -d "$SCRATCH" -tAc \
    "SELECT count(*) FROM $table" 2>/dev/null || echo 'MISSING')
  printf '%-22s %12s %12s' "$table" "$live" "$restored"

  if [ "$restored" = "MISSING" ]; then
    echo "   <-- NOT IN THE BACKUP"
    problems=$((problems + 1))
  elif [ "$live" != "n/a" ] && [ "$restored" -lt "$live" ] 2>/dev/null; then
    # Fewer is expected — the backup is from last night and the site has
    # been running since. More would mean something is very wrong.
    echo "   (older, as expected)"
  else
    echo
  fi
done

echo
if [ "$problems" -gt 0 ]; then
  echo "!! $problems table(s) missing from the backup. This is not a working backup."
  exit 1
fi
echo "==> the backup restores, and every table people typed into is in it."
echo "==> scratch database dropped."
