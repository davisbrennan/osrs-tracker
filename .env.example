# Copy to /srv/osrs/.env and fill in. Never commit the real file.

# ---- database ----
# POSTGRES_* are read by the db container; DATABASE_URL is what the app and
# the worker use, and it points at the compose service name, not localhost.
POSTGRES_USER=osrs
POSTGRES_PASSWORD=
POSTGRES_DB=osrs
DATABASE_URL=postgres://osrs:CHANGEME@db:5432/osrs

REDIS_URL=redis://cache:6379

# ---- site ----
SITE_URL=https://rspill.com
APP_URL=https://rspill.com
AUTH_URL=https://rspill.com

# Sessions are signed with this. Generate once and never rotate casually —
# changing it signs everyone out.
#   openssl rand -base64 32
BETTER_AUTH_SECRET=

# ---- email ----
# Values are quoted where they contain characters a shell would act on.
# EMAIL_FROM holds angle brackets, and `source .env` — which osrs-deploy and
# the backup script both do — reads an unquoted `<` as a redirect and dies.
# Docker Compose strips the quotes, so the app still sees the bare value.
# Sign-in links and price alerts. Without a key, emails are logged to the
# container instead of sent, which is fine locally and useless in production.
RESEND_API_KEY=
EMAIL_FROM="RSpill <hello@rspill.com>"

# ---- OSRS APIs ----
# The wiki asks consumers to identify themselves so they can contact you
# rather than silently blocking the client. This address goes in the
# User-Agent on every request, and it is also shown on the legal pages.
OSRS_CONTACT=you@example.com

# ---- admin ----
# Comma-separated. Empty means NOBODY is an admin, not everybody.
# Deliberately an env var rather than a database flag: a row can be changed by
# anything with database access, including a bug in this app.
ADMIN_EMAILS=you@example.com

# ---- backups ----
RESTIC_REPOSITORY=
RESTIC_PASSWORD=
B2_ACCOUNT_ID=
B2_ACCOUNT_KEY=
